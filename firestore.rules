rules_version = '2';
// Nexus Finance — each signed-in user can only read/write their own data.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---------- Investments: one ledger document per user (shape shared with the old CryptoLedger app) ----------
    function validLedger(d) {
      return d.keys().hasOnly(['transactions', 'assets', 'settings', 'goals', 'favorites', 'updatedAt', 'goal'])
        && d.keys().hasAll(['transactions', 'updatedAt'])
        && d.transactions is list
        && d.transactions.size() <= 50000
        && d.updatedAt is number
        && (!('assets' in d) || d.assets is map)
        && (!('settings' in d) || d.settings is map)
        && (!('goals' in d) || d.goals is list)
        && (!('favorites' in d) || d.favorites is list);
    }

    match /ledgers/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validLedger(request.resource.data);
    }

    // ---------- Expenses ----------
    function validTxn(d) {
      return d.keys().hasOnly(['txn_date', 'description', 'amount', 'category', 'direction', 'created_at'])
        && d.txn_date is string && d.txn_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.description is string && d.description.size() > 0 && d.description.size() <= 200
        && d.amount is number && d.amount >= 0
        && (d.category == null || (d.category is string && d.category.size() <= 80))
        && d.direction in ['IN', 'OUT']
        && d.created_at is number;
    }

    function validAccount(d) {
      return d.keys().hasOnly(['name', 'kind', 'balance', 'sort_order', 'created_at'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.kind in ['asset', 'bank', 'debt']
        && d.balance is number
        && d.sort_order is number
        && d.created_at is number;
    }

    match /expenses/{uid}/transactions/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validTxn(request.resource.data);
    }

    match /expenses/{uid}/accounts/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validAccount(request.resource.data);
    }

    // ---------- Electricity ----------
    function optNum(d, k) {
      return !(k in d) || d[k] == null || d[k] is number;
    }

    match /power/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['rate', 'billDay', 'unit'])
        && request.resource.data.rate is number && request.resource.data.rate >= 0
        && request.resource.data.billDay is number && request.resource.data.billDay >= 1 && request.resource.data.billDay <= 31
        && request.resource.data.unit in ['kWh', 'units'];
    }

    match /power/{uid}/readings/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['v', 't'])
        && request.resource.data.v is number && request.resource.data.t is number;
    }

    match /power/{uid}/appliances/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'watts', 'qty', 'hours'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.watts is number && request.resource.data.qty is number && request.resource.data.hours is number;
    }

    match /power/{uid}/cycles/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['start', 'end', 'units', 'rate', 'est', 'actual', 'actualUnits', 'actualReading'])
        && request.resource.data.start is string && request.resource.data.end is string
        && request.resource.data.units is number && request.resource.data.rate is number && request.resource.data.est is number
        && optNum(request.resource.data, 'actual') && optNum(request.resource.data, 'actualUnits') && optNum(request.resource.data, 'actualReading');
    }

    // ---------- Tasks ----------
    function validTask(d) {
      return d.keys().hasOnly(['title', 'notes', 'done', 'priority', 'due', 'list', 'subtasks', 'createdAt', 'completedAt', 'goalId'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.notes is string && d.notes.size() <= 2000
        && d.done is bool
        && d.priority in ['low', 'med', 'high']
        && (d.due == null || (d.due is string && d.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (d.list == null || (d.list is string && d.list.size() <= 24))
        && d.subtasks is list && d.subtasks.size() <= 50
        && d.createdAt is number
        && (d.completedAt == null || d.completedAt is number)
        && (!('goalId' in d) || d.goalId == null || (d.goalId is string && d.goalId.size() <= 64));
    }

    match /tasks/{uid}/items/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validTask(request.resource.data);
    }

    // ---------- Goals ----------
    function validGoal(d) {
      return d.keys().hasOnly(['title', 'why', 'area', 'status', 'startDate', 'targetDate', 'metric', 'unit', 'start', 'target', 'current', 'log', 'milestones', 'createdAt', 'completedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 140
        && d.why is string && d.why.size() <= 1000
        && d.area in ['career', 'finance', 'health', 'learning', 'relationships', 'personal']
        && d.status in ['active', 'paused', 'done', 'dropped']
        && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (d.targetDate == null || (d.targetDate is string && d.targetDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.metric in ['checklist', 'number', 'networth', 'portfolio']
        && d.unit is string && d.unit.size() <= 16
        && d.start is number && d.target is number && d.current is number
        && d.log is list && d.log.size() <= 400
        && d.milestones is list && d.milestones.size() <= 100
        && d.createdAt is number
        && (d.completedAt == null || d.completedAt is number);
    }

    match /goals/{uid}/items/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validGoal(request.resource.data);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
